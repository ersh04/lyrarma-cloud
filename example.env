# Server
SERVER_ADDRESS=":8080"
SERVER_READ_TIMEOUT="30m"
SERVER_WRITE_TIMEOUT="120s"

# Web-resources
WEB_STATIC_DIR="web/static"
WEB_ICONS_DIR="web/icons"
WEB_TEMPLATES_DIR="web/templates"
WEB_TRANSLATIONS_FILE="web/static/translations.json"

# Session cookie
SESSION_COOKIE_NAME="auth-session"
SESSION_COOKIE_PATH="/"
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE="Lax"

# Cloud API
# Local config for PostgreSQL from compose.db.yaml and compose.users_db.yaml
DATABASE_URL="postgres://user:user-local-password@localhost:5432/lyrarma_cloud?sslmode=disable"
USERS_DATABASE_URL="postgres://user:user-local-password@localhost:5433/lyrarma-services-users?sslmode=disable"
DATA_DIR="./data"
JWT_SECRET="local-dev-jwt-secret-change-before-production"
BETA_TEST_KEY="local-dev-beta-test-key-change-before-production"
JWT_TTL="24h"
MAX_UPLOAD_MB=10240
MAX_STORAGE_MB=1048576
DEFAULT_USER_PLAN=user
USER_PLANS_JSON=[{"name":"user","max_upload_mb":1024,"max_storage_mb":10240},{"name":"premium","max_upload_mb":10240,"max_storage_mb":102400},{"name":"admin","max_upload_mb":10240,"max_storage_mb":1048576}]

# S3 Storages
AWS_REGION=ex-1
AWS_ACCESS_KEY_ID=user-example
AWS_SECRET_ACCESS_KEY=local-dev-aws-secret-access-key

S3_BUCKET=lyrarma-cloud
S3_QUARANTINE_BUCKET=lyrarma-cloud-quarantine
S3_ENDPOINT=https://example.com/

# File scanning
SCANNER_ENABLED=true

SCANNER_WORKERS=2
SCANNER_POLL_INTERVAL=2s
SCANNER_TIMEOUT=10m
SCANNER_FILE_COMMAND=file
SCANNER_ANTIVIRUS_COMMAND="/usr/bin/clamdscan --stream"
SCANNER_IMAGE_COMMAND=identify
SCANNER_VIDEO_COMMAND=ffprobe
SCANNER_FRAME_COMMAND=ffmpeg
SCANNER_ARCHIVE_COMMAND=7z
# Команда получает путь и MIME-тип, код 1 блокирует файл, для видео передаются выбранные JPEG-кадры
SCANNER_MODERATION_COMMAND="/opt/lyrarma/nudenet/venv/bin/python /opt/lyrarma/nudenet/moderate.py"
SCANNER_MAX_ARCHIVE_DEPTH=3
SCANNER_MAX_ARCHIVE_FILES=10000
SCANNER_MAX_ARCHIVE_MB=5120
SCANNER_MAX_IMAGE_PIXELS=100000000
SCANNER_BLOCKED_MIME_TYPES=application/x-dosexec,application/x-executable,application/x-elf,application/x-mach-binary,application/x-object,application/x-pie-executable,application/x-sharedlib,application/x-msdownload,application/vnd.microsoft.portable-executable
