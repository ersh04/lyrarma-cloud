# Server
SERVER_ADDRESS=":8080"
SERVER_READ_TIMEOUT="30m"
SERVER_WRITE_TIMEOUT="120s"

# Web-resources
WEB_STATIC_DIR="web/static"
WEB_ICONS_DIR="web/icons"
WEB_TEMPLATES_DIR="web/templates"
WEB_TRANSLATIONS_FILE="web/static/translations.json"

# Session cookie
SESSION_COOKIE_NAME="auth-session"
SESSION_COOKIE_PATH="/"
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE="Lax"

# Cloud API
# Local config for PostgreSQL from compose.yaml
DATABASE_URL="postgres://user:user-local-password@localhost:5432/lyrarma_cloud?sslmode=disable"
DATA_DIR="./data"
JWT_SECRET="local-dev-jwt-secret-change-before-production"
BETA_TEST_KEY="local-dev-beta-test-key-change-before-production"
JWT_TTL="24h"
MAX_UPLOAD_MB=1024

# S3 Storages
AWS_REGION=ex-1
AWS_ACCESS_KEY_ID=user-example
AWS_SECRET_ACCESS_KEY=local-dev-aws-secret-access-key

S3_BUCKET=lyrarma-cloud
S3_ENDPOINT=https://example.com/
